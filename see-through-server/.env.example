# NF4 is the upstream low-VRAM path for this machine's 8 GB RTX 3060.
SEE_THROUGH_BACKEND=nf4
SEE_THROUGH_RESOLUTION=1024
SEE_THROUGH_DEPTH_RESOLUTION=768
SEE_THROUGH_STEPS=30
# Keep this false on native Windows; see upstream issue #52.
SEE_THROUGH_GROUP_OFFLOAD=false
SEE_THROUGH_CPU_OFFLOAD=false
SEE_THROUGH_TIMEOUT_SECONDS=9600
SEE_THROUGH_MAX_UPLOAD_MB=25
SEE_THROUGH_MAX_IMAGE_PIXELS=67108864
SEE_THROUGH_JOBS_DIR=workspace/api_jobs
SEE_THROUGH_HF_HOME=workspace/huggingface